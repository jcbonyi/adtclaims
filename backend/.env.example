PORT=4000
# Local: localhost Postgres. On Vercel, use a hosted URL (Neon/Supabase/Railway) — localhost will not work.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claims_tracking
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=8h
ADMIN_RESET_KEY=replace-with-reset-key

# Email notifications (valuations, renewals, claims)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MANAGEMENT_EMAIL_LIST=
CLAIMS_OPS_EMAIL_LIST=
# Daily 17:15 EAT claims-register Excel (defaults to aisha, jacob, communications @adtinsurance.co.ke)
CLAIMS_DAILY_REGISTER_EMAIL_LIST=aisha@adtinsurance.co.ke,jacob@adtinsurance.co.ke,communications@adtinsurance.co.ke
# Vercel Cron: set CRON_SECRET so /api/claims-notifications/cron/daily-register is authorized
CRON_SECRET=

# Policy renewals — SMS via Africa's Talking (optional)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER=
AFRICASTALKING_SANDBOX=false
AFRICASTALKING_WHATSAPP_FROM=
RENEWAL_OPS_EMAIL_LIST=
RENEWAL_CALLBACK_NUMBER=
# Optional Meta Cloud API for WhatsApp
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
# Optional: TZ=Africa/Nairobi
