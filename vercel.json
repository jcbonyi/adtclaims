{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/index.js",
      "functions": {
        "src/index.js": {
          "maxDuration": 60,
          "memory": 1024
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/_/backend/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ],
  "crons": [
    {
      "path": "/api/claims-notifications/cron/daily-register",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/renewals/cron/reminders",
      "schedule": "0 5 * * *"
    }
  ]
}
