{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend",
      "framework": "express"
    }
  },
  "crons": [
    {
      "path": "/_/backend/api/claims-notifications/cron/daily-register",
      "schedule": "15 14 * * *"
    }
  ]
}
